{
  "name": "joyorgenie-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,web -c yellow,cyan \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "convex dev",
    "dev:web": "vinext dev --port 5179",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "convex run seed:seedDemo",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/workflow": "^0.4.6",
    "ai": "^7.0.83",
    "convex": "^1.45.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@edge-runtime/vm": "^5.0.0",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.26",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0-beta.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.92.0"
  }
}
